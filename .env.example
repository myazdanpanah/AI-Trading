# ══════════════════════════════════════════════════════════════════════
# AI-Trading Platform — Environment Variables
# Copy this to .env and fill in the values
# ══════════════════════════════════════════════════════════════════════

# ── Django Core ──────────────────────────────────────────────────────

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-minimum-50-chars

# Settings module: development | production | security
DJANGO_SETTINGS_MODULE=crypto_platform.settings.production

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ── Database (PostgreSQL) ───────────────────────────────────────────

DB_NAME=crypto_platform
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_HOST=localhost
DB_PORT=5432

# SSL mode for database connections: disable | allow | prefer | require
DB_SSLMODE=prefer

# ── Redis ────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0

# ── AI / LLM Settings ──────────────────────────────────────────────

# AI mode: off | lite | standard | cloud
AI_MODE=standard

# Local Ollama (required for standard mode)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Cloud LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────

# Comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── Security ─────────────────────────────────────────────────────────

# Enable SSL redirect in production
SECURE_SSL_REDIRECT=False

# JWT token lifetimes (minutes)
JWT_ACCESS_LIFETIME=30
JWT_REFRESH_LIFETIME=1440

# ── Trading Settings ────────────────────────────────────────────────

# Enable live trading (DANGEROUS — only for advanced users)
LIVE_TRADING_ENABLED=False

# Exchange settings
EXCHANGE_NAME=binance
EXCHANGE_TESTNET=True

# ── News & Social Sources ───────────────────────────────────────────

NEWS_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ── Monitoring ──────────────────────────────────────────────────────

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus retention
PROMETHEUS_RETENTION=30d

# ── Celery ──────────────────────────────────────────────────────────

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
